{
  "name": "Healthcare Platform",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "start": "bash .cursor/scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev"
    }
  ],
  "ports": [
    { "name": "API", "port": 3001 },
    { "name": "Web", "port": 5173 }
  ]
}
