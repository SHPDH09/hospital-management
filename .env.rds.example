# =============================================================================
# AWS Aurora PostgreSQL — Healthcare Platform (EC2 production)
# Copy to apps/api/.env and replace YOUR_RDS_PASSWORD
# =============================================================================

# Writer endpoint ONLY (migrations + all writes)
DATABASE_URL="postgresql://postgres:YOUR_RDS_PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require"

# Reader endpoint (optional — public search queries only, NOT for migrations)
# DATABASE_URL_READ="postgresql://postgres:YOUR_RDS_PASSWORD@database-1.cluster-ro-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require"

# Auth — change in production!
JWT_SECRET="change-me-to-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=production

# Frontend URL (your EC2 IP or domain)
CORS_ORIGIN="http://YOUR_EC2_IP:5173"

# Super Admin (created on seed / admin:create)
ADMIN_EMAIL="your-admin@email.com"
ADMIN_PASSWORD="your-secure-password"
