# AWS RDS PostgreSQL — Writer (primary cluster endpoint)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@database-1.cluster-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require"

# AWS RDS PostgreSQL — Read replica (read-only queries)
DATABASE_URL_READ="postgresql://postgres:YOUR_PASSWORD@database-1.cluster-ro-covwo0uikrnc.us-east-1.rds.amazonaws.com:5432/postgres?schema=public&sslmode=require"

# Local development fallback (Docker Compose)
# DATABASE_URL="postgresql://healthcare:healthcare_dev@localhost:5432/healthcare_platform?schema=public"

JWT_SECRET="dev-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# AI — built-in model works without API keys (default)
AI_ENABLED=true
AI_PROVIDER=builtin
AI_DEFAULT_MODEL=healthcare-builtin-v1
# Optional for advanced responses:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
