  audience    Json?
  isActive    Boolean              @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("scheduled_communications")
}

model SystemAnnouncement {
