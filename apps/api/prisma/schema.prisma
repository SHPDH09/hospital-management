generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_STAFF
  HOSPITAL_ADMIN
  BRANCH_ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
  ACCOUNTANT
  PHARMACIST
  LAB_STAFF
  MANAGER
  PATIENT
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  PHARMACY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  CORRECTION_REQUESTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BillStatus {
  DRAFT
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionPlanTier {
  FREE
  BASIC
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionChangeSource {
  MANUAL
  PAYMENT
  SYSTEM
}

enum AdvertisementStatus {
  PENDING
  APPROVED
  ACTIVE
  PAUSED
  SCHEDULED
  EXPIRED
  REJECTED
  CHANGES_REQUESTED
}

enum AdvertisementType {
  HOMEPAGE_BANNER
  SEARCH_PROMOTION
  FEATURED_HOSPITAL
  FEATURED_DOCTOR
  FEATURED_CLINIC
  FEATURED_SERVICE
  HEALTH_PACKAGE
  PROMOTIONAL_CARD
  SEARCH_AD
}

enum AdPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum AdPricingModel {
  FIXED
  CPM
  CPC
  CPA
  CAMPAIGN
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  APPOINTMENT_BOOKED
  CONVERTED
  LOST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient       Patient?
  doctor        Doctor?
  staff         Staff?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  loginHistory  LoginHistory[]
  assignedComplaints Complaint[] @relation("AssignedComplaints")
  platformStaffProfile PlatformStaffProfile?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  type               OrganizationType
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  email              String?
  phone              String?
  website            String?
  address            String?
  city               String?
  state              String?
  pinCode            String?
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(PENDING)
  isActive           Boolean            @default(true)
  isPubliclyListed   Boolean            @default(false)
  emergencyAvailable Boolean            @default(false)
  openingHours       Json?
  facilities         String[]
  ownerName          String?
  registrationNumber String?
  averageRating      Float              @default(0)
  reviewCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branches        Branch[]
  doctors         Doctor[]
  staff           Staff[]
  departments     Department[]
  services        Service[]
  appointments    Appointment[]
  bills           Bill[]
  subscriptions   Subscription[]
  advertisements  Advertisement[]
  leads           Lead[]
  reviews         Review[]
  patientOrgs     PatientOrganization[]
  documents       Document[]
  complaints      Complaint[]
  coupons         Coupon[]
  platformStaffAssignments PlatformStaffAssignment[]

  @@index([city, state])
  @@index([verificationStatus, isActive, isPubliclyListed])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  city           String?
  state          String?
  pinCode        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctors      Doctor[]
  staff        Staff[]
  departments  Department[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("branches")
}

model Patient {
  id               String    @id @default(uuid())
  userId           String    @unique
  fullName         String
  dateOfBirth      DateTime?
  gender           Gender?
  address          String?
  city             String?
  state            String?
  emergencyContact String?
  bloodGroup       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations PatientOrganization[]
  appointments  Appointment[]
  bills         Bill[]
  reviews       Review[]

  @@map("patients")
}

model PatientOrganization {
  id             String   @id @default(uuid())
  patientId      String
  organizationId String
  patientNumber  String?
  notes          String?
  createdAt      DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([patientId, organizationId])
  @@index([organizationId])
  @@map("patient_organizations")
}

model Doctor {
  id                 String   @id @default(uuid())
  userId             String   @unique
  organizationId     String
  branchId           String?
  departmentId       String?
  fullName           String
  specialization     String?
  qualification      String?
  experience         Int?
  registrationNumber String?
  consultationFee    Float    @default(0)
  bio                String?
  photoUrl           String?
  languages          String[]
  isActive           Boolean  @default(true)
  averageRating      Float    @default(0)
  reviewCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  slots        AppointmentSlot[]
  reviews      Review[]
  advertisements Advertisement[]

  @@index([organizationId])
  @@index([specialization])
  @@map("doctors")
}

model Staff {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  branchId       String?
  fullName       String
  role           UserRole
  employeeId     String?
  department     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@map("staff")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  doctors      Doctor[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("departments")
}

model Service {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  price          Float
  duration       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billItems    BillItem[]

  @@index([organizationId])
  @@map("services")
}

model AppointmentSlot {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
  @@map("appointment_slots")
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String?
  patientId      String
  doctorId       String
  departmentId   String?
  slotId         String?
  appointmentDate DateTime         @db.Date
  startTime      String
  endTime        String?
  type           String            @default("consultation")
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id])
  slot         AppointmentSlot? @relation(fields: [slotId], references: [id])
  bills        Bill[]

  @@index([organizationId, appointmentDate])
  @@index([doctorId, appointmentDate, status])
  @@index([patientId])
  @@map("appointments")
}

model Bill {
  id             String     @id @default(uuid())
  organizationId String
  patientId      String
  appointmentId  String?
  billNumber     String
  subtotal       Float      @default(0)
  tax            Float      @default(0)
  discount       Float      @default(0)
  total          Float      @default(0)
  status         BillStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  items        BillItem[]
  payments     Payment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, createdAt])
  @@map("bills")
}

model BillItem {
  id          String  @id @default(uuid())
  billId      String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("bill_items")
}

model Payment {
  id            String        @id @default(uuid())
  billId        String
  amount        Float
  method        String
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SubscriptionPlan {
  id                String                @id @default(uuid())
  tier              SubscriptionPlanTier?
  code              String                @unique
  name              String
  description       String?
  price             Float?
  monthlyPrice      Float?
  yearlyPrice       Float?
  currency          String                @default("INR")
  trialDays         Int                   @default(0)
  features          String[]
  userLimit         Int?
  doctorLimit       Int?
  patientLimit      Int?
  storageLimitMb    Int?
  branchLimit       Int?
  appointmentLimit  Int?
  isActive          Boolean               @default(true)
  isDefault         Boolean               @default(false)
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  subscriptions     Subscription[]
  historyAsPrevious SubscriptionHistory[] @relation("PreviousPlan")
  historyAsNew      SubscriptionHistory[] @relation("NewPlan")

  @@map("subscription_plans")
}

model Subscription {
  id             String                   @id @default(uuid())
  organizationId String
  planId         String
  status         SubscriptionStatus       @default(TRIAL)
  billingCycle   BillingCycle             @default(MONTHLY)
  price          Float?
  discount       Float?
  startDate      DateTime                 @default(now())
  endDate        DateTime?
  trialEndsAt    DateTime?
  suspendReason  String?
  changeSource   SubscriptionChangeSource @default(SYSTEM)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan      @relation(fields: [planId], references: [id])
  history      SubscriptionHistory[]

  @@index([organizationId])
  @@index([status, endDate])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String                   @id @default(uuid())
  subscriptionId String
  organizationId String
  previousPlanId String?
  newPlanId      String?
  previousPrice  Float?
  newPrice       Float?
  previousStatus String?
  newStatus      String?
  reason         String?
  changeSource   SubscriptionChangeSource @default(MANUAL)
  changedById    String?
  changedByEmail String?
  createdAt      DateTime                 @default(now())

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousPlan SubscriptionPlan? @relation("PreviousPlan", fields: [previousPlanId], references: [id])
  newPlan      SubscriptionPlan? @relation("NewPlan", fields: [newPlanId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([organizationId, createdAt])
  @@map("subscription_history")
}

model Advertisement {
  id                   String              @id @default(uuid())
  organizationId       String?
  doctorId             String?
  campaignName         String?
  title                String
  description          String?
  category             String?
  type                 AdvertisementType
  status               AdvertisementStatus @default(PENDING)
  imageUrl             String?
  mobileImageUrl       String?
  videoUrl             String?
  logoUrl              String?
  ctaText              String?
  targetUrl            String?
  landingType          String?
  landingId            String?
  targetCities         String[]
  targetStates         String[]
  targetPinCodes       String[]
  targetRadiusKm       Float?
  audienceType         String?
  healthcareCategories String[]
  platforms            String[]            @default(["website"])
  startDate            DateTime?
  endDate              DateTime?
  scheduledAt          DateTime?
  budget               Float?
  dailyBudget          Float?
  pricingModel         AdPricingModel      @default(FIXED)
  adPlanId             String?
  priority             Int                 @default(0)
  placement            String?
  impressions          Int                 @default(0)
  uniqueImpressions    Int                 @default(0)
  clicks               Int                 @default(0)
  leads                Int                 @default(0)
  appointments         Int                 @default(0)
  conversions          Int                 @default(0)
  profileViews         Int                 @default(0)
  callClicks           Int                 @default(0)
  whatsappClicks       Int                 @default(0)
  paidAmount           Float               @default(0)
  pendingAmount        Float?
  campaignCost         Float?
  paymentStatus        AdPaymentStatus     @default(UNPAID)
  rejectionReason      String?
  flaggedReason        String?
  isPaused             Boolean             @default(false)
  createdByEmail       String?
  approvedByEmail      String?
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  adPlan       AdPlan?       @relation(fields: [adPlanId], references: [id])
  history      AdHistory[]
  adLeads      Lead[]

  @@index([status, type])
  @@index([organizationId])
  @@index([startDate, endDate])
  @@map("advertisements")
}

model AdPlan {
  id                    String            @id @default(uuid())
  name                  String
  adType                AdvertisementType
  price                 Float
  durationDays          Int
  pricingModel          AdPricingModel    @default(FIXED)
  description           String?
  placement             String?
  priority              Int               @default(0)
  recommendedDimensions Json?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  advertisements Advertisement[]

  @@map("ad_plans")
}

model AdHistory {
  id               String   @id @default(uuid())
  advertisementId  String
  action           String
  performedByEmail String?
  reason           String?
  details          Json?
  createdAt        DateTime @default(now())

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([advertisementId, createdAt])
  @@map("ad_history")
}

model Lead {
  id              String     @id @default(uuid())
  organizationId  String
  advertisementId String?
  name            String?
  email           String?
  phone           String?
  source          String?
  status          LeadStatus @default(NEW)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  advertisement Advertisement? @relation(fields: [advertisementId], references: [id])

  @@index([organizationId, status])
  @@index([advertisementId])
  @@map("leads")
}

model Review {
  id             String   @id @default(uuid())
  patientId      String
  organizationId String?
  doctorId       String?
  rating         Int
  comment        String?
  response       String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])

  @@map("reviews")
}

model Document {
  id             String   @id @default(uuid())
  organizationId String
  fileName       String
  fileKey        String
  mimeType       String?
  fileSize       Int?
  uploadedBy     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum ComplaintStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintType {
  PATIENT
  HOSPITAL
  DOCTOR
  GENERAL
}

enum DiscountType {
  PERCENT
  FIXED
}

enum LocationType {
  COUNTRY
  STATE
  CITY
  DISTRICT
  AREA
}

model Complaint {
  id             String            @id @default(uuid())
  ticketId       String            @unique
  subject        String
  description    String
  type           ComplaintType       @default(GENERAL)
  priority       ComplaintPriority   @default(MEDIUM)
  status         ComplaintStatus     @default(NEW)
  assignedToId   String?
  organizationId String?
  complainantName  String?
  complainantEmail String?
  complainantPhone String?
  resolution     String?
  internalNotes  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignedTo   User?         @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, priority])
  @@map("complaints")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  minAmount      Float?
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  platformWide   Boolean      @default(true)
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("coupons")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model LoginHistory {
  id            String   @id @default(uuid())
  userId        String?
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean  @default(true)
  failureReason String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@map("login_history")
}

enum CmsContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CmsPageType {
  STATIC
  LEGAL
  LOCATION
}

model CmsPage {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  content         String           @db.Text
  pageType        CmsPageType      @default(STATIC)
  status          CmsContentStatus @default(DRAFT)
  isPublished     Boolean          @default(false)
  metaTitle       String?
  metaDescription String?
  keywords        String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?
  robots          String?          @default("index,follow")
  publishAt       DateTime?
  unpublishAt     DateTime?
  version         Int              @default(1)
  authorEmail     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("cms_pages")
}

model CmsBlog {
  id              String           @id @default(uuid())
  title           String
  slug            String           @unique
  coverImageUrl   String?
  content         String           @db.Text
  author          String?
  category        String?
  tags            String[]
  metaTitle       String?
  metaDescription String?
  keywords        String?
  status          CmsContentStatus @default(DRAFT)
  publishAt       DateTime?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("cms_blogs")
}

model CmsBanner {
  id          String           @id @default(uuid())
  title       String
  bannerType  String           @default("HOMEPAGE")
  imageUrl    String?
  mobileImageUrl String?
  description String?
  ctaText     String?
  ctaLink     String?
  startDate   DateTime?
  endDate     DateTime?
  status      CmsContentStatus @default(DRAFT)
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("cms_banners")
}

model CmsFaq {
  id        String           @id @default(uuid())
  question  String
  answer    String           @db.Text
  category  String           @default("General")
  status    CmsContentStatus @default(PUBLISHED)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("cms_faqs")
}

model CmsTestimonial {
  id        String           @id @default(uuid())
  name      String
  imageUrl  String?
  role      String?
  content   String           @db.Text
  rating    Int              @default(5)
  status    CmsContentStatus @default(DRAFT)
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("cms_testimonials")
}

model CmsPromotion {
  id          String           @id @default(uuid())
  title       String
