  isActive  Boolean          @default(true)
  startsAt  DateTime         @default(now())
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("system_announcements")
}

enum EmergencySystemStatus {
  NORMAL
  PARTIAL_RESTRICTION
  EMERGENCY_MODE
  FULL_MAINTENANCE
}

enum EmergencySuspensionType {
  ORGANIZATION
  DOCTOR
  USER
}

enum EmergencySuspensionReason {
  SECURITY_ISSUE
  VERIFICATION_ISSUE
  POLICY_VIOLATION
  FRAUD_SUSPICION
  TECHNICAL_ISSUE
  OTHER
}

enum EmergencyAnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

model EmergencyActionLog {
  id               String   @id @default(uuid())
  action           String
  performedById    String?
  performedByEmail String?
  reason           String
  details          Json?
  affectedScope    String?
