generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_STAFF
  HOSPITAL_ADMIN
  BRANCH_ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
  ACCOUNTANT
  PHARMACIST
  LAB_STAFF
  MANAGER
  PATIENT
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  PHARMACY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  CORRECTION_REQUESTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  REJECTED
}

enum AppointmentPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  PHONE
  FOLLOW_UP
  EMERGENCY
  WALK_IN
  HOME_VISIT
  DIAGNOSTIC
}

enum BillStatus {
  DRAFT
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  AUTHORIZED
  PENDING
  CAPTURED
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIAL_REFUND
  DISPUTED
}

enum PaymentPurpose {
  APPOINTMENT
  CONSULTATION
  FOLLOW_UP
  ONLINE_CONSULTATION
  EMERGENCY
  HOME_VISIT
  SERVICE
  DIAGNOSTIC
  HEALTH_PACKAGE
  PROCEDURE
  TREATMENT
  SUBSCRIPTION
  ADVERTISEMENT
  REFERRAL_COMMISSION
  OTHER
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  WALLET
  PAYMENT_LINK
  CASH
  POS
  BANK_TRANSFER
}

enum SubscriptionPlanTier {
  FREE
  BASIC
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionChangeSource {
  MANUAL
  PAYMENT
  SYSTEM
}

enum AdvertisementStatus {
  PENDING
  APPROVED
  ACTIVE
  EXPIRED
  REJECTED
}

enum AdvertisementType {
  HOMEPAGE_BANNER
  SEARCH_PROMOTION
  FEATURED_HOSPITAL
  FEATURED_DOCTOR
  FEATURED_CLINIC
  HEALTH_PACKAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  FOLLOW_UP
  APPOINTMENT_BOOKED
  VISITED
  TREATMENT_STARTED
  CONVERTED
  NOT_INTERESTED
  WRONG_NUMBER
  DUPLICATE
  LOST
  INVALID
}

enum LeadType {
  PATIENT
  HOSPITAL
  CLINIC
  DOCTOR
  REFERRAL
  ADVERTISEMENT
  PARTNER
}

enum LeadSource {
  WEBSITE
  MOBILE_APP
  GOOGLE
  SOCIAL_MEDIA
  ADVERTISEMENT
  REFERRAL
  AASHA
  HOSPITAL
  CLINIC
  DOCTOR
  PARTNER
  CALL
  WHATSAPP
  EMAIL
  MANUAL_ENTRY
  API
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum ReviewType {
  HOSPITAL
  CLINIC
  DOCTOR
  SERVICE
  APPOINTMENT
}

enum ReviewStatus {
  PENDING
  UNDER_MODERATION
  APPROVED
  REJECTED
  HIDDEN
  REPORTED
  FLAGGED
  REMOVED
  RESTORED
}

enum ReviewSource {
  PLATFORM
  WEBSITE
  MOBILE_APP
  APPOINTMENT
  QR_CODE
  CAMPAIGN
  HOSPITAL
  CLINIC
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientAccountStatus {
  ACTIVE
  PENDING_PROFILE
  UNVERIFIED
  SUSPENDED
  BLOCKED
  DEACTIVATED
}

enum PatientRegistrationSource {
  DIRECT
  REFERRAL
  AASHA
  ADVERTISEMENT
  GOOGLE
  WEBSITE
  CAMPAIGN
  DOCTOR_REFERRAL
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient       Patient?
  doctor        Doctor?
  staff         Staff?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  loginHistory  LoginHistory[]
  assignedComplaints Complaint[] @relation("AssignedComplaints")
  assignedLeads      Lead[]      @relation("AssignedLeads")
  leadActivities     LeadActivity[]
  leadFollowUps      LeadFollowUp[] @relation("LeadFollowUps")
  moderatedReviews   Review[]       @relation("ModeratedReviews")
  reviewActivities   ReviewActivity[]
  reviewReports      ReviewReport[] @relation("ReviewReports")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  type               OrganizationType
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  email              String?
  phone              String?
  website            String?
  address            String?
  city               String?
  state              String?
  pinCode            String?
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(PENDING)
  isActive           Boolean            @default(true)
  isPubliclyListed   Boolean            @default(false)
  emergencyAvailable Boolean            @default(false)
  openingHours       Json?
  facilities         String[]
  ownerName          String?
  registrationNumber String?
  averageRating      Float              @default(0)
  reviewCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branches        Branch[]
  doctors         Doctor[]
  staff           Staff[]
  departments     Department[]
  services        Service[]
  appointments    Appointment[]
  bills           Bill[]
  subscriptions   Subscription[]
  advertisements  Advertisement[]
  leads           Lead[]
  reviews         Review[]
  patientOrgs     PatientOrganization[]
  documents       Document[]
  complaints      Complaint[]
  coupons         Coupon[]

  @@index([city, state])
  @@index([verificationStatus, isActive, isPubliclyListed])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  city           String?
  state          String?
  pinCode        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctors      Doctor[]
  staff        Staff[]
  departments  Department[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("branches")
}

model Patient {
  id                 String                    @id @default(uuid())
  userId             String                    @unique
  globalPatientId    String                    @unique
  fullName           String
  dateOfBirth        DateTime?
  gender             Gender?
  address            String?
  city               String?
  state              String?
  pinCode            String?
  photoUrl           String?
  emergencyContact   String?
  bloodGroup         String?
  profileCompleted   Boolean                   @default(false)
  accountStatus      PatientAccountStatus      @default(PENDING_PROFILE)
  registrationSource PatientRegistrationSource @default(DIRECT)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations PatientOrganization[]
  appointments  Appointment[]
  bills         Bill[]
  reviews       Review[]
  leads         Lead[]

  @@index([globalPatientId])
  @@index([city, state])
  @@index([accountStatus])
  @@map("patients")
}

model PatientOrganization {
  id             String                    @id @default(uuid())
  patientId      String
  organizationId String
  patientNumber  String?
  sourceType     PatientRegistrationSource @default(DIRECT)
  referralName   String?
  referralId     String?
  notes          String?
  createdAt      DateTime                  @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([patientId, organizationId])
  @@index([organizationId])
  @@map("patient_organizations")
}

model Doctor {
  id                 String   @id @default(uuid())
  userId             String   @unique
  organizationId     String
  branchId           String?
  departmentId       String?
  fullName           String
  specialization     String?
  qualification      String?
  experience         Int?
  registrationNumber String?
  consultationFee    Float    @default(0)
  bio                String?
  photoUrl           String?
  languages          String[]
  isActive           Boolean  @default(true)
  verificationStatus VerificationStatus @default(PENDING)
  accountActivated   Boolean  @default(false)
  averageRating      Float    @default(0)
  reviewCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  slots        AppointmentSlot[]
  reviews      Review[]
  leads        Lead[]

  @@index([organizationId])
  @@index([specialization])
  @@map("doctors")
}

model Staff {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  branchId       String?
  fullName       String
  role           UserRole
  employeeId     String?
  department     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@map("staff")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  doctors      Doctor[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("departments")
}

model Service {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  price          Float
  duration       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billItems    BillItem[]
  reviews      Review[]

  @@index([organizationId])
  @@map("services")
}

model AppointmentSlot {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
  @@map("appointment_slots")
}

model Appointment {
  id                String                   @id @default(uuid())
  appointmentNumber String                   @unique
  organizationId    String
  branchId          String?
  patientId         String
  doctorId          String
  departmentId      String?
  slotId            String?
  appointmentDate   DateTime                 @db.Date
  startTime         String
  endTime           String?
  type              AppointmentType          @default(IN_PERSON)
  status            AppointmentStatus        @default(PENDING)
  paymentStatus     AppointmentPaymentStatus @default(PENDING)
  notes             String?
  referralSource    PatientRegistrationSource?
  referralId        String?
  referralName      String?
  advertisementId   String?
  cancellationReason String?
  rescheduledFromId String?
  checkedInAt       DateTime?
  tokenNumber       String?
  isEmergency       Boolean                  @default(false)
  isOnline          Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id])
  slot         AppointmentSlot? @relation(fields: [slotId], references: [id])
  bills        Bill[]
  leads        Lead[]
  reviews      Review[]

  @@index([organizationId, appointmentDate])
  @@index([doctorId, appointmentDate, status])
  @@index([patientId])
  @@index([appointmentNumber])
  @@index([status, appointmentDate])
  @@map("appointments")
}

model Bill {
  id             String     @id @default(uuid())
  organizationId String
  patientId      String
  appointmentId  String?
  billNumber     String
  subtotal       Float      @default(0)
  tax            Float      @default(0)
  discount       Float      @default(0)
  total          Float      @default(0)
  status         BillStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  items        BillItem[]
  payments     Payment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, createdAt])
  @@map("bills")
}

model BillItem {
  id          String  @id @default(uuid())
  billId      String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("bill_items")
}

model Payment {
  id                String         @id @default(uuid())
  paymentNumber     String         @unique
  billId            String
  amount            Float
  method            PaymentMethod  @default(UPI)
  purpose           PaymentPurpose @default(APPOINTMENT)
  status            PaymentStatus  @default(PENDING)
  currency          String         @default("INR")
  transactionId     String?
  gateway           String?
  gatewayOrderId    String?
  gatewayPaymentId  String?
  idempotencyKey    String?        @unique
  platformFee       Float          @default(0)
  providerShare     Float          @default(0)
  refundAmount      Float          @default(0)
  refundReason      String?
  refundId          String?
  webhookStatus     String?
  webhookVerified   Boolean        @default(false)
  riskLevel         String         @default("LOW")
  reconciliationStatus String?
  paidAt            DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentNumber])
  @@index([status, createdAt])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model SubscriptionPlan {
  id                String                @id @default(uuid())
  tier              SubscriptionPlanTier?
  code              String                @unique
  name              String
  description       String?
  price             Float?
  monthlyPrice      Float?
  yearlyPrice       Float?
  currency          String                @default("INR")
  trialDays         Int                   @default(0)
  features          String[]
  userLimit         Int?
  doctorLimit       Int?
  patientLimit      Int?
  storageLimitMb    Int?
  branchLimit       Int?
  appointmentLimit  Int?
  isActive          Boolean               @default(true)
  isDefault         Boolean               @default(false)
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  subscriptions     Subscription[]
  historyAsPrevious SubscriptionHistory[] @relation("PreviousPlan")
  historyAsNew      SubscriptionHistory[] @relation("NewPlan")

  @@map("subscription_plans")
}

model Subscription {
  id             String                   @id @default(uuid())
  organizationId String
  planId         String
  status         SubscriptionStatus       @default(TRIAL)
  billingCycle   BillingCycle             @default(MONTHLY)
  price          Float?
  discount       Float?
  startDate      DateTime                 @default(now())
  endDate        DateTime?
  trialEndsAt    DateTime?
  suspendReason  String?
  changeSource   SubscriptionChangeSource @default(SYSTEM)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan      @relation(fields: [planId], references: [id])
  history      SubscriptionHistory[]

  @@index([organizationId])
  @@index([status, endDate])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String                   @id @default(uuid())
  subscriptionId String
  organizationId String
  previousPlanId String?
  newPlanId      String?
  previousPrice  Float?
  newPrice       Float?
  previousStatus String?
  newStatus      String?
  reason         String?
  changeSource   SubscriptionChangeSource @default(MANUAL)
  changedById    String?
  changedByEmail String?
  createdAt      DateTime                 @default(now())

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousPlan SubscriptionPlan? @relation("PreviousPlan", fields: [previousPlanId], references: [id])
  newPlan      SubscriptionPlan? @relation("NewPlan", fields: [newPlanId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([organizationId, createdAt])
  @@map("subscription_history")
}

model Advertisement {
  id             String              @id @default(uuid())
  organizationId String?
  title          String
  type           AdvertisementType
  status         AdvertisementStatus @default(PENDING)
  imageUrl       String?
  targetUrl      String?
  startDate      DateTime?
  endDate        DateTime?
  impressions    Int                 @default(0)
  clicks         Int                 @default(0)
  budget         Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  leads        Lead[]

  @@map("advertisements")
}

model Lead {
  id                  String           @id @default(uuid())
  leadNumber          String           @unique
  organizationId      String?
  type                LeadType         @default(PATIENT)
  name                String?
  email               String?
  phone               String?
  city                String?
  state               String?
  source              LeadSource       @default(WEBSITE)
  campaign            String?
  referralName        String?
  referralType        String?
  specialty           String?
  service             String?
  preferredDate       DateTime?
  preferredTime       String?
  status              LeadStatus       @default(NEW)
  priority            LeadPriority     @default(MEDIUM)
  temperature         LeadTemperature  @default(COLD)
  score               Int              @default(0)
  assignedToId        String?
  assignedAt          DateTime?
  interestedDoctorId  String?
  patientId           String?
  appointmentId       String?
  advertisementId     String?
  phoneVerified       Boolean          @default(false)
  emailVerified       Boolean          @default(false)
  nextFollowUpAt      DateTime?
  lastContactAt       DateTime?
  lostReason          String?
  isDuplicate         Boolean          @default(false)
  mergedIntoId        String?
  tags                String[]         @default([])
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedTo       User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  interestedDoctor Doctor?        @relation(fields: [interestedDoctorId], references: [id])
  patient          Patient?       @relation(fields: [patientId], references: [id])
  appointment      Appointment?   @relation(fields: [appointmentId], references: [id])
  advertisement    Advertisement? @relation(fields: [advertisementId], references: [id])
  activities       LeadActivity[]
  followUps        LeadFollowUp[]

  @@index([leadNumber])
  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([source, type])
  @@index([phone])
  @@map("leads")
}

model LeadActivity {
  id        String      @id @default(uuid())
  leadId    String
  userId    String?
  action    String
  oldStatus LeadStatus?
  newStatus LeadStatus?
  notes     String?
  createdAt DateTime    @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model LeadFollowUp {
  id           String    @id @default(uuid())
  leadId       String
  assignedToId String?
  scheduledAt  DateTime
  reason       String?
  status       String    @default("PENDING")
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("LeadFollowUps", fields: [assignedToId], references: [id])

  @@index([leadId, scheduledAt])
  @@index([assignedToId, scheduledAt])
  @@map("lead_follow_ups")
}

model Review {
  id                 String           @id @default(uuid())
  reviewNumber       String           @unique
  patientId          String
  organizationId     String?
  doctorId           String?
  appointmentId      String?          @unique
  serviceId          String?
  type               ReviewType       @default(HOSPITAL)
  source             ReviewSource     @default(PLATFORM)
  rating             Int
  doctorRating       Int?
  staffRating        Int?
  cleanlinessRating  Int?
  waitingRating      Int?
  facilitiesRating   Int?
  comment            String?
  originalComment    String?
  response           String?
  responseStatus     String?
  respondedAt        DateTime?
  status             ReviewStatus     @default(PENDING)
  isVerifiedVisit    Boolean          @default(false)
  isAnonymous        Boolean          @default(false)
  isPublished        Boolean          @default(false)
  reportCount        Int              @default(0)
  helpfulCount       Int              @default(0)
  riskScore          String           @default("LOW")
  sentiment          ReviewSentiment?
  moderationReason   String?
  moderatedById      String?
  moderatedAt        DateTime?
  tags               String[]         @default([])
  editedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  moderatedBy  User?         @relation("ModeratedReviews", fields: [moderatedById], references: [id])
  reports      ReviewReport[]
  activities   ReviewActivity[]

  @@index([reviewNumber])
  @@index([status, createdAt])
  @@index([organizationId, status])
  @@index([doctorId, status])
  @@index([rating])
  @@map("reviews")
}

model ReviewReport {
  id         String    @id @default(uuid())
  reviewId   String
  reporterId String?
  reason     String
  details    String?
  status     String    @default("PENDING")
  decision   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User?  @relation("ReviewReports", fields: [reporterId], references: [id])

  @@index([reviewId])
  @@map("review_reports")
}

model ReviewActivity {
  id        String        @id @default(uuid())
  reviewId  String
  userId    String?
  action    String
  oldStatus ReviewStatus?
  newStatus ReviewStatus?
  notes     String?
  createdAt DateTime      @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([reviewId, createdAt])
  @@map("review_activities")
}

model Document {
  id             String   @id @default(uuid())
  organizationId String
  fileName       String
  fileKey        String
  mimeType       String?
  fileSize       Int?
  uploadedBy     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum ComplaintStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintType {
  PATIENT
  HOSPITAL
  DOCTOR
  GENERAL
}

enum DiscountType {
  PERCENT
  FIXED
}

enum LocationType {
  COUNTRY
  STATE
  CITY
  DISTRICT
  AREA
}

model Complaint {
  id             String            @id @default(uuid())
  ticketId       String            @unique
  subject        String
  description    String
  type           ComplaintType       @default(GENERAL)
  priority       ComplaintPriority   @default(MEDIUM)
  status         ComplaintStatus     @default(NEW)
  assignedToId   String?
  organizationId String?
  complainantName  String?
  complainantEmail String?
  complainantPhone String?
  resolution     String?
  internalNotes  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignedTo   User?         @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, priority])
  @@map("complaints")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  minAmount      Float?
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  platformWide   Boolean      @default(true)
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("coupons")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model LoginHistory {
  id            String   @id @default(uuid())
  userId        String?
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean  @default(true)
  failureReason String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@map("login_history")
}

model CmsPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_pages")
}

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  department  String?
  services    String[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("specializations")
}

enum MasterCatalogKind {
  HOSPITAL_TYPE
  CLINIC_TYPE
  FACILITY
  HEALTH_PACKAGE_CATEGORY
}

model PlatformDepartment {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_departments")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services PlatformHealthcareService[]

  @@map("service_categories")
}

model PlatformHealthcareService {
  id           String   @id @default(uuid())
  name         String
  categoryId   String?
  description  String?
  defaultPrice Float?
  duration     Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("platform_healthcare_services")
}

model TestCategory {
  id        String   @id @default(uuid())
  name      String
  group     String?
  parentId  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   TestCategory?  @relation("TestCategoryHierarchy", fields: [parentId], references: [id])
  children TestCategory[] @relation("TestCategoryHierarchy")
  tests    DiagnosticTest[]

  @@index([parentId])
  @@map("test_categories")
}

model DiagnosticTest {
  id           String   @id @default(uuid())
  name         String
  categoryId   String?
  sampleType   String?
  preparation  String?
  defaultPrice Float?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category TestCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("diagnostic_tests")
}

model Medicine {
  id           String   @id @default(uuid())
  name         String
  genericName  String?
  brandName    String?
  category     String?
  dosageForm   String?
  strength     String?
  manufacturer String?
  unit         String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("medicines")
}

model MasterCatalog {
  id          String            @id @default(uuid())
  kind        MasterCatalogKind
  name        String
  description String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([kind, name])
  @@index([kind, isActive])
  @@map("master_catalog")
}

model InsuranceProvider {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?
  contact   String?
  website   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("insurance_providers")
}

model DoctorQualification {
  id          String   @id @default(uuid())
  name        String   @unique
  shortName   String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("doctor_qualifications")
}

model StaffRoleMaster {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("staff_role_masters")
}

model Location {
  id       String       @id @default(uuid())
  name     String
  type     LocationType
  parentId String?
  pinCode  String?
  isActive Boolean      @default(true)

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")

  @@index([type, parentId])
  @@map("locations")
}

model CommunicationTemplate {
  id        String   @id @default(uuid())
  name      String
  channel   String
  subject   String?
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("communication_templates")
}
