generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_STAFF
  HOSPITAL_ADMIN
  BRANCH_ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
  ACCOUNTANT
  PHARMACIST
  LAB_STAFF
  MANAGER
  PATIENT
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  PHARMACY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  CORRECTION_REQUESTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BillStatus {
  DRAFT
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionPlanTier {
  FREE
  BASIC
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionChangeSource {
  MANUAL
  PAYMENT
  SYSTEM
}

enum AdvertisementStatus {
  PENDING
  APPROVED
  ACTIVE
  EXPIRED
  REJECTED
}

enum AdvertisementType {
  HOMEPAGE_BANNER
  SEARCH_PROMOTION
  FEATURED_HOSPITAL
  FEATURED_DOCTOR
  FEATURED_CLINIC
  HEALTH_PACKAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  APPOINTMENT_BOOKED
  CONVERTED
  LOST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient       Patient?
  doctor        Doctor?
  staff         Staff?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  loginHistory  LoginHistory[]
  assignedComplaints Complaint[] @relation("AssignedComplaints")
  assignedLeads      Lead[]       @relation("AssignedLeads")
  aiAuditLogs        AiAuditLog[]
  approvalRequests   ApprovalRequest[] @relation("ApprovalRequester")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  type               OrganizationType
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  email              String?
  phone              String?
  website            String?
  address            String?
  city               String?
  state              String?
  pinCode            String?
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(PENDING)
  isActive           Boolean            @default(true)
  isPubliclyListed   Boolean            @default(false)
  emergencyAvailable Boolean            @default(false)
  openingHours       Json?
  facilities         String[]
  ownerName          String?
  registrationNumber String?
  averageRating      Float              @default(0)
  reviewCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branches        Branch[]
  doctors         Doctor[]
  staff           Staff[]
  departments     Department[]
  services        Service[]
  appointments    Appointment[]
  bills           Bill[]
  subscriptions   Subscription[]
  advertisements  Advertisement[]
  leads           Lead[]
  reviews         Review[]
  patientOrgs     PatientOrganization[]
  documents       Document[]
  complaints      Complaint[]
  coupons         Coupon[]

  @@index([city, state])
  @@index([verificationStatus, isActive, isPubliclyListed])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  city           String?
  state          String?
  pinCode        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctors      Doctor[]
  staff        Staff[]
  departments  Department[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("branches")
}

model Patient {
  id               String    @id @default(uuid())
  userId           String    @unique
  fullName         String
  dateOfBirth      DateTime?
  gender           Gender?
  address          String?
  city             String?
  state            String?
  emergencyContact String?
  bloodGroup       String?
  profileCompleted Boolean   @default(false)
  profileCompletionPercent Int @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations PatientOrganization[]
  appointments  Appointment[]
  bills         Bill[]
  reviews       Review[]

  @@map("patients")
}

model PatientOrganization {
  id             String   @id @default(uuid())
  patientId      String
  organizationId String
  patientNumber  String?
  notes          String?
  createdAt      DateTime @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([patientId, organizationId])
  @@index([organizationId])
  @@map("patient_organizations")
}

model Doctor {
  id                 String   @id @default(uuid())
  userId             String   @unique
  organizationId     String
  branchId           String?
  departmentId       String?
  fullName           String
  specialization     String?
  qualification      String?
  experience         Int?
  registrationNumber String?
  consultationFee    Float    @default(0)
  bio                String?
  photoUrl           String?
  languages          String[]
  isActive           Boolean  @default(true)
  averageRating      Float    @default(0)
  reviewCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  slots        AppointmentSlot[]
  reviews      Review[]

  @@index([organizationId])
  @@index([specialization])
  @@map("doctors")
}

model Staff {
  id             String   @id @default(uuid())
  userId         String   @unique
  organizationId String
  branchId       String?
  fullName       String
  role           UserRole
  employeeId     String?
  department     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@map("staff")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  doctors      Doctor[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("departments")
}

model Service {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  price          Float
  duration       Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billItems    BillItem[]

  @@index([organizationId])
  @@map("services")
}

model AppointmentSlot {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime @db.Date
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
  @@map("appointment_slots")
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String?
  patientId      String
  doctorId       String
  departmentId   String?
  slotId         String?
  appointmentDate DateTime         @db.Date
  startTime      String
  endTime        String?
  type           String            @default("consultation")
  status         AppointmentStatus @default(PENDING)
  notes          String?
  noShowRisk     NoShowRisk        @default(LOW)
  confirmationStatus String        @default("PENDING")
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id])
  slot         AppointmentSlot? @relation(fields: [slotId], references: [id])
  bills        Bill[]

  @@index([organizationId, appointmentDate])
  @@index([doctorId, appointmentDate, status])
  @@index([patientId])
  @@map("appointments")
}

model Bill {
  id             String     @id @default(uuid())
  organizationId String
  patientId      String
  appointmentId  String?
  billNumber     String
  subtotal       Float      @default(0)
  tax            Float      @default(0)
  discount       Float      @default(0)
  total          Float      @default(0)
  status         BillStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  items        BillItem[]
  payments     Payment[]

  @@unique([organizationId, billNumber])
  @@index([organizationId, createdAt])
  @@map("bills")
}

model BillItem {
  id          String  @id @default(uuid())
  billId      String
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("bill_items")
}

model Payment {
  id            String        @id @default(uuid())
  billId        String
  amount        Float
  method        String
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SubscriptionPlan {
  id                String                @id @default(uuid())
  tier              SubscriptionPlanTier?
  code              String                @unique
  name              String
  description       String?
  price             Float?
  monthlyPrice      Float?
  yearlyPrice       Float?
  currency          String                @default("INR")
  trialDays         Int                   @default(0)
  features          String[]
  userLimit         Int?
  doctorLimit       Int?
  patientLimit      Int?
  storageLimitMb    Int?
  branchLimit       Int?
  appointmentLimit  Int?
  isActive          Boolean               @default(true)
  isDefault         Boolean               @default(false)
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  subscriptions     Subscription[]
  historyAsPrevious SubscriptionHistory[] @relation("PreviousPlan")
  historyAsNew      SubscriptionHistory[] @relation("NewPlan")

  @@map("subscription_plans")
}

model Subscription {
  id             String                   @id @default(uuid())
  organizationId String
  planId         String
  status         SubscriptionStatus       @default(TRIAL)
  billingCycle   BillingCycle             @default(MONTHLY)
  price          Float?
  discount       Float?
  startDate      DateTime                 @default(now())
  endDate        DateTime?
  trialEndsAt    DateTime?
  suspendReason  String?
  changeSource   SubscriptionChangeSource @default(SYSTEM)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan      @relation(fields: [planId], references: [id])
  history      SubscriptionHistory[]

  @@index([organizationId])
  @@index([status, endDate])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String                   @id @default(uuid())
  subscriptionId String
  organizationId String
  previousPlanId String?
  newPlanId      String?
  previousPrice  Float?
  newPrice       Float?
  previousStatus String?
  newStatus      String?
  reason         String?
  changeSource   SubscriptionChangeSource @default(MANUAL)
  changedById    String?
  changedByEmail String?
  createdAt      DateTime                 @default(now())

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousPlan SubscriptionPlan? @relation("PreviousPlan", fields: [previousPlanId], references: [id])
  newPlan      SubscriptionPlan? @relation("NewPlan", fields: [newPlanId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([organizationId, createdAt])
  @@map("subscription_history")
}

model Advertisement {
  id             String              @id @default(uuid())
  organizationId String?
  title          String
  type           AdvertisementType
  status         AdvertisementStatus @default(PENDING)
  imageUrl       String?
  targetUrl      String?
  startDate      DateTime?
  endDate        DateTime?
  impressions    Int                 @default(0)
  clicks         Int                 @default(0)
  budget         Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("advertisements")
}

model Lead {
  id             String     @id @default(uuid())
  organizationId String
  name           String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  notes          String?
  score          Int                @default(0)
  temperature    LeadTemperature    @default(COLD)
  assignedToId   String?
  aiSummary      String?
  nextBestAction String?
  lastScoredAt   DateTime?
  specialty      String?
  lastContactAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  activities   LeadActivity[]

  @@index([organizationId, status])
  @@index([temperature, score])
  @@map("leads")
}

model Review {
  id             String   @id @default(uuid())
  patientId      String
  organizationId String?
  doctorId       String?
  rating         Int
  comment        String?
  response       String?
  isPublished    Boolean  @default(true)
  sentiment      ReviewSentiment?
  topics         String[] @default([])
  riskScore      String   @default("LOW")
  aiSummary      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])

  @@map("reviews")
}

model Document {
  id             String   @id @default(uuid())
  organizationId String
  fileName       String
  fileKey        String
  mimeType       String?
  fileSize       Int?
  uploadedBy     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum ComplaintStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintType {
  PATIENT
  HOSPITAL
  DOCTOR
  GENERAL
}

enum DiscountType {
  PERCENT
  FIXED
}

enum LocationType {
  COUNTRY
  STATE
  CITY
  DISTRICT
  AREA
}

model Complaint {
  id             String            @id @default(uuid())
  ticketId       String            @unique
  subject        String
  description    String
  type           ComplaintType       @default(GENERAL)
  priority       ComplaintPriority   @default(MEDIUM)
  status         ComplaintStatus     @default(NEW)
  assignedToId   String?
  organizationId String?
  complainantName  String?
  complainantEmail String?
  complainantPhone String?
  resolution     String?
  internalNotes  String?
  aiCategory     String?
  aiPriority     ComplaintPriority?
  aiSummary      String?
  suggestedResponse String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignedTo   User?         @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, priority])
  @@map("complaints")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  minAmount      Float?
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  platformWide   Boolean      @default(true)
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("coupons")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model LoginHistory {
  id            String   @id @default(uuid())
  userId        String?
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean  @default(true)
  failureReason String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@map("login_history")
}

model CmsPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_pages")
}

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  department  String?
  services    String[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("specializations")
}

enum MasterCatalogKind {
  HOSPITAL_TYPE
  CLINIC_TYPE
  FACILITY
  HEALTH_PACKAGE_CATEGORY
}

model PlatformDepartment {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_departments")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services PlatformHealthcareService[]

  @@map("service_categories")
}

model PlatformHealthcareService {
  id           String   @id @default(uuid())
  name         String
  categoryId   String?
  description  String?
  defaultPrice Float?
  duration     Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("platform_healthcare_services")
}

model TestCategory {
  id        String   @id @default(uuid())
  name      String
  group     String?
  parentId  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   TestCategory?  @relation("TestCategoryHierarchy", fields: [parentId], references: [id])
  children TestCategory[] @relation("TestCategoryHierarchy")
  tests    DiagnosticTest[]

  @@index([parentId])
  @@map("test_categories")
}

model DiagnosticTest {
  id           String   @id @default(uuid())
  name         String
  categoryId   String?
  sampleType   String?
  preparation  String?
  defaultPrice Float?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category TestCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("diagnostic_tests")
}

model Medicine {
  id           String   @id @default(uuid())
  name         String
  genericName  String?
  brandName    String?
  category     String?
  dosageForm   String?
  strength     String?
  manufacturer String?
  unit         String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("medicines")
}

model MasterCatalog {
  id          String            @id @default(uuid())
  kind        MasterCatalogKind
  name        String
  description String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([kind, name])
  @@index([kind, isActive])
  @@map("master_catalog")
}

model InsuranceProvider {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?
  contact   String?
  website   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("insurance_providers")
}

model DoctorQualification {
  id          String   @id @default(uuid())
  name        String   @unique
  shortName   String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("doctor_qualifications")
}

model StaffRoleMaster {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("staff_role_masters")
}

model Location {
  id       String       @id @default(uuid())
  name     String
  type     LocationType
  parentId String?
  pinCode  String?
  isActive Boolean      @default(true)

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")

  @@index([type, parentId])
  @@map("locations")
}

model CommunicationTemplate {
  id        String   @id @default(uuid())
  name      String
  channel   String
  subject   String?
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("communication_templates")
}

// ─── AI & Automation ─────────────────────────────────────────────────────────

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum NoShowRisk {
  LOW
  MEDIUM
  HIGH
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD
}

enum AutomationModule {
  LEADS
  APPOINTMENTS
  PAYMENTS
  REVIEWS
  COMPLAINTS
  SUBSCRIPTIONS
  VERIFICATION
  GENERAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model AiSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

model AiAuditLog {
  id             String   @id @default(uuid())
  requestId      String   @unique @default(uuid())
  userId         String?
  organizationId String?
  module         String
  feature        String
  inputRef       String?
  outputSummary  String?  @db.Text
  model          String?
  status         String
  error          String?
  humanApproval  Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([module, feature])
  @@map("ai_audit_logs")
}

model AiInsight {
  id             String   @id @default(uuid())
  entityType     String
  entityId       String
  insightType    String
  content        Json
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId, insightType])
  @@index([entityType, entityId])
  @@map("ai_insights")
}

model AutomationRule {
  id          String           @id @default(uuid())
  name        String
  module      AutomationModule @default(GENERAL)
  trigger     String
  conditions  Json             @default("[]")
  actions     Json             @default("[]")
  delayMinutes Int             @default(0)
  schedule    String?
  channel     String?
  audience    String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  executions AutomationExecution[]

  @@index([isActive, trigger])
  @@map("automation_rules")
}

model AutomationExecution {
  id         String   @id @default(uuid())
  ruleId     String
  entityType String?
  entityId   String?
  status     String
  result     Json?
  error      String?
  ranAt      DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, ranAt])
  @@map("automation_executions")
}

model JobQueue {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  scheduledAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([type, status])
  @@map("job_queue")
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  action    String
  notes     String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model ApprovalRequest {
  id           String         @id @default(uuid())
  requesterId  String
  actionType   String
  entityType   String
  entityId     String
  payload      Json?
  status       ApprovalStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime       @default(now())

  requester User @relation("ApprovalRequester", fields: [requesterId], references: [id])

  @@index([status, createdAt])
  @@map("approval_requests")
}

enum EmergencySuspensionType {
  ORGANIZATION
  DOCTOR
  USER
}

enum EmergencySuspensionReason {
  SECURITY_ISSUE
  VERIFICATION_ISSUE
  POLICY_VIOLATION
  FRAUD_SUSPICION
  TECHNICAL_ISSUE
  OTHER
}

enum EmergencyAnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

model EmergencyActionLog {
  id               String   @id @default(uuid())
  action           String
  performedById    String?
  performedByEmail String?
  reason           String
  details          Json?
  affectedScope    String?
  ipAddress        String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("emergency_action_logs")
}

model EmergencyAnnouncement {
  id               String                        @id @default(uuid())
  title            String
  message          String                        @db.Text
  severity         EmergencyAnnouncementSeverity @default(WARNING)
  affectedServices String[]
  displayLocations String[]
  startsAt         DateTime                      @default(now())
  endsAt           DateTime?
  isActive         Boolean                       @default(true)
  createdByEmail   String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@map("emergency_announcements")
}

model ScheduledMaintenance {
  id              String   @id @default(uuid())
  title           String
  description     String?
  maintenanceType String   @default("full")
  affectedModules String[]
  startAt         DateTime
  endAt           DateTime
  isActive        Boolean  @default(true)
  autoActivate    Boolean  @default(true)
  createdByEmail  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startAt, endAt])
  @@map("scheduled_maintenances")
}

model EmergencySuspension {
  id                    String                    @id @default(uuid())
  type                  EmergencySuspensionType
  targetId              String
  targetName            String?
  reason                EmergencySuspensionReason
  reasonNotes           String?
  effects               Json?
  isActive              Boolean                   @default(true)
  suspendedById         String?
  suspendedByEmail      String?
  suspendedAt           DateTime                  @default(now())
  liftedAt              DateTime?
  liftedByEmail         String?
  appointmentResolution String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([type, targetId, isActive])
  @@map("emergency_suspensions")
}
