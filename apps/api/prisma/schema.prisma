model PlatformStaffAttendance {
  id             String    @id @default(uuid())
  staffProfileId String
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  staffProfile PlatformStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, checkInAt])
  @@map("platform_staff_attendance")
}

model PlatformStaffAnnouncement {
  id             String   @id @default(uuid())
  title          String
  message        String   @db.Text
  audience       String[] @default(["all"])
  isActive       Boolean  @default(true)
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("platform_staff_announcements")
}

model PlatformPermissionHistory {
  id             String   @id @default(uuid())
  staffProfileId String
  module         String
  action         String
  previousValue  String?
  newValue       String?
  changedByEmail String?
  reason         String?
  createdAt      DateTime @default(now())

  staffProfile PlatformStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, createdAt])
  @@map("platform_permission_history")
}

model PlatformTemporaryPermission {
  id             String   @id @default(uuid())
  staffProfileId String
  module         String
  action         String
  reason         String?
  startsAt       DateTime @default(now())
  expiresAt      DateTime
  grantedByEmail String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  staffProfile PlatformStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId, expiresAt])
  @@map("platform_temporary_permissions")
}

model PlatformPermissionRequest {
  id             String                  @id @default(uuid())
  staffProfileId String
  module         String
  action         String
  reason         String
  status         PermissionRequestStatus @default(PENDING)
  reviewedByEmail String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  staffProfile PlatformStaffProfile @relation("Requester", fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("platform_permission_requests")
}

model PasswordResetRequest {
  id             String    @id @default(uuid())
  userId         String
  identifier     String
  otpHash        String
  resetToken     String?   @unique
  otpAttempts    Int       @default(0)
  otpExpiresAt   DateTime
  resetExpiresAt DateTime?
  verifiedAt     DateTime?
  usedAt         DateTime?
  ipAddress      String?
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
  @@map("password_reset_requests")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model PasswordResetRateLimit {
  id          String    @id @default(uuid())
  identifier  String
  ipAddress   String?
  sendCount   Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([identifier, ipAddress])
  @@map("password_reset_rate_limits")
}

model PatientPhoneOtp {
  id         String    @id @default(uuid())
  userId     String
  phone      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone])
  @@map("patient_phone_otps")
}

// ─── Referral / AASHA System ─────────────────────────────────────────────────

enum ReferralAgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  REJECTED
}

enum ReferralConnectionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

enum PatientSourceType {
  DIRECT
  GOOGLE
  ADVERTISEMENT
  HOSPITAL_WEBSITE
  SOCIAL_MEDIA
  ASHA
  REFERRAL_PARTNER
  CAMPAIGN
  DOCTOR_REFERRAL
}

enum ReferralEventType {
  LINK_GENERATED
  LINK_CLICK
  QR_SCAN
  LANDING_VISIT
  FORM_STARTED
  FORM_SUBMITTED
  PATIENT_REGISTERED
  APPOINTMENT_BOOKED
  PATIENT_VISITED
  TREATMENT_COMPLETED
  COMMISSION_ELIGIBLE
  COMMISSION_PAID
}

enum CommissionStatus {
  NOT_ELIGIBLE
  PENDING
  UNDER_REVIEW
  APPROVED
  PAYABLE
  PAID
  REJECTED
  REVERSED
  ON_HOLD
}

enum CommissionRuleType {
  FIXED
  TREATMENT_BASED
  PERCENTAGE
  SERVICE_BASED
}

enum PayoutStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
}

enum AttributionPolicy {
  FIRST_CLICK
  LAST_CLICK
  REGISTRATION_TIME
}

model AshaProfile {
  id                 String              @id @default(uuid())
  userId             String?             @unique
  ashaId             String              @unique
  ashaName           String
  ashaPhoto          String?
  mobile             String?
  email              String?
  address            String?
  area               String?
  village            String?
  district           String?
  state              String?
  pinCode            String?
  idProofUrl         String?
  joiningDate        DateTime?
  verificationStatus VerificationStatus  @default(PENDING)
  status             ReferralAgentStatus @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user         User?                      @relation(fields: [userId], references: [id])
  connections  ReferralHospitalConnection[] @relation("AshaConnections")
  campaigns    ReferralCampaign[]         @relation("AshaCampaigns")
  events       ReferralTrackingEvent[]    @relation("AshaEvents")
  attributions PatientReferralAttribution[] @relation("AshaAttributions")
  commissions  ReferralCommission[]       @relation("AshaCommissions")
  wallet       ReferralWallet?            @relation("AshaWallet")

  @@index([status])
  @@map("asha_profiles")
}

model ReferralPartner {
  id                   String              @id @default(uuid())
  userId               String?             @unique
  referralId           String              @unique
  referralPartnerName  String
  referralPhoto        String?
  mobile               String?
  email                String?
  address              String?
  area                 String?
  district             String?
  state                String?
  pinCode              String?
  idProofUrl           String?
  referralCode         String              @unique
  verificationStatus   VerificationStatus  @default(PENDING)
  status               ReferralAgentStatus @default(PENDING)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user         User?                      @relation(fields: [userId], references: [id])
  connections  ReferralHospitalConnection[] @relation("PartnerConnections")
  campaigns    ReferralCampaign[]         @relation("PartnerCampaigns")
  events       ReferralTrackingEvent[]    @relation("PartnerEvents")
  attributions PatientReferralAttribution[] @relation("PartnerAttributions")
  commissions  ReferralCommission[]       @relation("PartnerCommissions")
  wallet       ReferralWallet?            @relation("PartnerWallet")

  @@index([status])
  @@index([referralCode])
  @@map("referral_partners")
}

model ReferralCommissionPlan {
  id             String             @id @default(uuid())
  organizationId String?
  name           String
  ruleType       CommissionRuleType
  rules          Json
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization?              @relation(fields: [organizationId], references: [id])
  connections  ReferralHospitalConnection[]

  @@map("referral_commission_plans")
}

model ReferralHospitalConnection {
  id                 String                   @id @default(uuid())
  organizationId     String
  ashaProfileId      String?
  referralPartnerId  String?
  connectionDate     DateTime                 @default(now())
  effectiveDate      DateTime?
  status             ReferralConnectionStatus @default(PENDING)
  commissionPlanId   String?
  totalPatients      Int                      @default(0)
  totalTreatments    Int                      @default(0)
  totalCommission    Float                    @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ashaProfile    AshaProfile?            @relation("AshaConnections", fields: [ashaProfileId], references: [id])
  referralPartner ReferralPartner?       @relation("PartnerConnections", fields: [referralPartnerId], references: [id])
  commissionPlan ReferralCommissionPlan? @relation(fields: [commissionPlanId], references: [id])

  @@index([organizationId])
  @@index([ashaProfileId])
  @@index([referralPartnerId])
  @@map("referral_hospital_connections")
}

model ReferralCampaign {
  id                String   @id @default(uuid())
  organizationId    String?
  ashaProfileId     String?
  referralPartnerId String?
  name              String
  referralCode      String   @unique
  referralLink      String
  qrCodeUrl         String?
  clicks            Int      @default(0)
  uniqueVisitors    Int      @default(0)
  qrScans           Int      @default(0)
  formsStarted      Int      @default(0)
  formsSubmitted    Int      @default(0)
  registrations     Int      @default(0)
  appointments      Int      @default(0)
  treatments        Int      @default(0)
  revenue           Float    @default(0)
  commission        Float    @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization?              @relation(fields: [organizationId], references: [id])
  ashaProfile     AshaProfile?               @relation("AshaCampaigns", fields: [ashaProfileId], references: [id])
  referralPartner ReferralPartner?           @relation("PartnerCampaigns", fields: [referralPartnerId], references: [id])
  events          ReferralTrackingEvent[]
  attributions    PatientReferralAttribution[]

  @@index([referralCode])
  @@map("referral_campaigns")
}

model ReferralTrackingEvent {
  id                String            @id @default(uuid())
  eventType         ReferralEventType
  ashaProfileId     String?
  referralPartnerId String?
  organizationId    String?
  campaignId        String?
  patientId         String?
  appointmentId     String?
  metadata          Json?
  createdAt         DateTime          @default(now())

  ashaProfile     AshaProfile?     @relation("AshaEvents", fields: [ashaProfileId], references: [id])
  referralPartner ReferralPartner? @relation("PartnerEvents", fields: [referralPartnerId], references: [id])
  campaign        ReferralCampaign? @relation(fields: [campaignId], references: [id])
  patient         Patient?         @relation(fields: [patientId], references: [id])

  @@index([ashaProfileId, createdAt])
  @@index([referralPartnerId, createdAt])
  @@index([organizationId, eventType])
  @@map("referral_tracking_events")
}

model PatientReferralAttribution {
  id                   String            @id @default(uuid())
  patientId            String
  organizationId       String
  sourceType           PatientSourceType
  ashaProfileId        String?
  referralPartnerId    String?
  campaignId           String?
  referralDisplayName  String?
  referralDisplayId    String?
  attributionPolicy    AttributionPolicy @default(REGISTRATION_TIME)
  firstTouchAt         DateTime?
  registrationTouchAt  DateTime?
  treatmentStatus      String?
  commissionStatus     CommissionStatus  @default(NOT_ELIGIBLE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ashaProfile     AshaProfile?     @relation("AshaAttributions", fields: [ashaProfileId], references: [id])
  referralPartner ReferralPartner? @relation("PartnerAttributions", fields: [referralPartnerId], references: [id])
  campaign        ReferralCampaign? @relation(fields: [campaignId], references: [id])
  commissions     ReferralCommission[]

  @@unique([patientId, organizationId])
  @@index([organizationId, sourceType])
  @@map("patient_referral_attributions")
}

model ReferralCommission {
  id               String           @id @default(uuid())
  organizationId   String
  ashaProfileId    String?
  referralPartnerId String?
  patientId        String
  attributionId    String?
  appointmentId    String?
  billId           String?
  eligibleAmount   Float            @default(0)
  commissionAmount Float            @default(0)
  status           CommissionStatus @default(PENDING)
  holdReason       String?
  fraudFlag        Boolean          @default(false)
  approvedAt       DateTime?
  paidAt           DateTime?
  paymentId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ashaProfile     AshaProfile?              @relation("AshaCommissions", fields: [ashaProfileId], references: [id])
  referralPartner ReferralPartner?          @relation("PartnerCommissions", fields: [referralPartnerId], references: [id])
  patient         Patient                   @relation(fields: [patientId], references: [id])
  attribution     PatientReferralAttribution? @relation(fields: [attributionId], references: [id])

  @@index([organizationId, status])
  @@index([ashaProfileId])
  @@index([referralPartnerId])
  @@map("referral_commissions")
}

model ReferralWallet {
  id                String   @id @default(uuid())
  ashaProfileId     String?  @unique
  referralPartnerId String?  @unique
  totalEarned       Float    @default(0)
  pending           Float    @default(0)
  approved          Float    @default(0)
  paid              Float    @default(0)
  onHold            Float    @default(0)
  updatedAt         DateTime @updatedAt

  ashaProfile     AshaProfile?     @relation("AshaWallet", fields: [ashaProfileId], references: [id])
  referralPartner ReferralPartner? @relation("PartnerWallet", fields: [referralPartnerId], references: [id])
  payouts         ReferralPayout[]

  @@map("referral_wallets")
}

model ReferralPayout {
  id            String       @id @default(uuid())
  walletId      String
  amount        Float
  status        PayoutStatus @default(PENDING)
  bankDetails   Json?
  transactionId String?
  requestedAt   DateTime     @default(now())
  paidAt        DateTime?
  createdAt     DateTime     @default(now())

  wallet ReferralWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@map("referral_payouts")
}

model OrganizationReferralSettings {
  id                    String            @id @default(uuid())
  organizationId        String            @unique
  referralEnabled       Boolean           @default(true)
  acceptAsha            Boolean           @default(true)
  acceptReferralPartners Boolean          @default(true)
  commissionHoldDays      Int               @default(7)
  minPayout             Float             @default(500)
  requireApproval         Boolean           @default(true)
  attributionPolicy       AttributionPolicy @default(REGISTRATION_TIME)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_referral_settings")
}

